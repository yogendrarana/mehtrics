{
  "name": "mehtrics",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bunx biome lint --write",
    "format": "bun --filter @mehtrics/app format && bun --filter @mehtrics/www format",

    "build": "bun --filter '*' build",
    "build:app": "bun --filter @mehtrics/app build",
    "build:www": "bun --filter @mehtrics/www build",
    "build:tracker": "bun build apps/app/src/tracker/index.ts --outfile apps/app/public/tracker.js --minify",
    "build:docs": "bun --filter @mehtrics/docs build",

    "dev": "bun dev:www & bun dev:app",
    "dev:app": "bun --filter @mehtrics/app dev",

    "dev:www": "bun --filter @mehtrics/www dev",
    "dev:docs": "bun --filter @mehtrics/docs dev",
    "dev:worker": "bun run --watch apps/app/src/lib/worker.ts",

    "db:generate": "bun --filter @mehtrics/db db:generate",
    "db:migrate": "bun --filter @mehtrics/db db:migrate",
    "db:seed": "bun --filter @mehtrics/db db:seed",
    "db:studio": "bun --filter @mehtrics/db db:studio",
    "db:push": "bun --filter @mehtrics/db db:push",

    "worker:event": "bun --filter @mehtrics/app worker:event",
    "worker:aggregation": "bun --filter @mehtrics/app worker:aggregation"

  }
}
