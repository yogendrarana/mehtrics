{
  "name": "mehtrics",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bunx biome lint --write",
    "format": "bun --filter @mehtrics/web format",

    "build": "bun --filter '*' build",
    "build:web": "bun --filter @mehtrics/web build",
    "build:analytics": "bun --filter @mehtrics/analytics build",
    "build:docs": "bun --filter @mehtrics/docs build",

    "dev:web": "bun --filter @mehtrics/web dev",
    "dev:docs": "bun --filter @mehtrics/docs dev",
    "dev:worker": "bun run --watch apps/web/src/lib/worker.ts",

    "db:generate": "bun --filter @mehtrics/db db:generate",
    "db:migrate": "bun --filter @mehtrics/db db:migrate",
    "db:seed": "bun --filter @mehtrics/db db:seed",
    "db:studio": "bun --filter @mehtrics/db db:studio",
    "db:push": "bun --filter @mehtrics/db db:push",

    "worker:event": "bun --filter @mehtrics/analytics worker:event",
    "worker:aggregation": "bun --filter @mehtrics/analytics worker:aggregation"
  }
}
