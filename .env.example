# ============================================================
# Mehtrics — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ----- App -----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Database -----
DATABASE_URL=postgresql://mehtrics:mehtrics@localhost:5432/mehtrics

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Auth -----
BETTER_AUTH_SECRET=change-me-to-a-64-char-random-secret
BETTER_AUTH_URL=http://localhost:3000

# ----- Dashboard (Self-hosted) -----
DASHBOARD_PORT=5500

# ----- SaaS Web -----
WEB_PORT=3000

# ----- Stripe (Phase 9 — optional) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
